# Data driver: "local" (default, browser localStorage demo data) or "rest" (future Laravel API)
VITE_API_DRIVER=local
# Base URL of the future Laravel REST API, e.g. https://api.darzibabu.example/api/v1
VITE_API_URL=
# Simulated network latency for the local driver, in milliseconds
VITE_DEMO_LATENCY=180
